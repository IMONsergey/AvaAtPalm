---
import Photo from './Photo.astro';
import type { Residence } from '../data/residences';
interface Props {residence:Residence;}
const {residence:r}=Astro.props;
---
<article class="residence-card" aria-labelledby={`unit-${r.unit}-title`} data-reveal>
 <div class="residence-info">
  <div class="residence-top"><div class="residence-identifiers"><div class="pills"><span>Unit {r.unit}</span><span>{r.bedrooms} Bedroom</span></div><p class="parking">{r.parking} Parking Spaces</p></div><a class="open-residence" href={`/residences/${r.unit}/`} aria-label={`Explore Unit ${r.unit}, ${r.bedrooms} bedroom residence`}><span aria-hidden="true">+</span></a></div>
  <h3 class="display" id={`unit-${r.unit}-title`}>{r.bedrooms} Bedroom<span>Residences</span></h3>
  <dl><div><dt>Internal Area</dt><dd>{r.internal} <span>sq. ft.</span></dd></div><div><dt>External Area</dt><dd>{r.external} <span>sq. ft.</span></dd></div><div class="total"><dt>Total Area</dt><dd>{r.total} <span>sq. ft.</span></dd></div></dl>
 </div>
 <div class="residence-drawings"><a class="plan-thumb" href={`/residences/${r.unit}/`} aria-label={`See Unit ${r.unit} floor plan and details`}><Photo name={r.plan} alt={`Floor plan of Unit ${r.unit}`} sizes="(max-width:767px) calc(100vw - 96px), 42vw"/></a><div class="orientation"><Photo name={r.orientation} alt={`Orientation of Unit ${r.unit} towards Palm Jumeirah`} sizes="120px"/><Photo name={r.floor} alt={`Unit ${r.unit} floor position in the AVA tower`} sizes="70px"/></div></div>
</article>
<style>
 .residence-card{background:var(--paper);color:var(--ink);display:flex;flex-direction:column;min-width:0}.residence-info{padding:32px 42px}.residence-top{display:flex;justify-content:space-between;align-items:start;gap:12px}.pills{display:flex;flex-wrap:wrap;gap:8px}.pills span{font-size:14px;line-height:22px;padding:7px 16px;border:1px solid var(--ink);border-radius:999px;white-space:nowrap}.open-residence{display:grid;place-items:center;width:51px;height:51px;border-radius:50%;background:var(--navy);color:var(--cream);flex:none;transition:background .2s}.open-residence span{font-weight:300;font-size:30px;line-height:1}.open-residence:hover{background:#34526d}.parking{font-size:12px;line-height:18px;margin-top:8px}.residence-info h3{font-size:clamp(48px,5vw,96px);line-height:1.111;margin:24px 0;letter-spacing:-.015em}.residence-info h3 span{display:block;color:var(--peach);font-size:.5694em}.residence-info dl{display:flex;flex-direction:column;gap:8px;margin:0;font-family:var(--metric);font-weight:300;font-size:20px;line-height:32px}.residence-info dl>div{display:flex;gap:14px;justify-content:space-between;align-items:baseline}.residence-info dd{margin:0;text-align:right;white-space:nowrap}.residence-info dd span{font-size:14px}.residence-info .total{border-top:1px solid var(--peach);padding-top:14px;margin-top:2px;font-weight:400}.residence-drawings{padding:24px;background:var(--cream);display:grid;grid-template-columns:minmax(0,393px) 144px;gap:16px;align-items:start;flex:1}.plan-thumb{display:block;background:var(--paper)}.plan-thumb :global(img){width:100%;height:auto;mix-blend-mode:darken}.orientation{display:flex;flex-direction:column;gap:16px;align-items:center;background:var(--paper);padding:16px}.orientation :global(img:first-child){width:104px;height:113px;object-fit:contain;mix-blend-mode:darken}.orientation :global(img:last-child){width:48px;height:142px;object-fit:contain;mix-blend-mode:darken}@media(max-width:767px){.residence-info{padding:24px 24px 32px}.pills span{font-size:13px;padding:6px 10px}.parking{font-size:13px}.residence-info h3{font-size:44px;line-height:52px;margin:24px 0}.residence-info h3 span{font-size:32px;line-height:38px}.residence-info dl{font-size:16px}.residence-info dd span{font-size:13px}.residence-drawings{padding:24px;display:flex;flex-direction:column}.orientation{flex-direction:row;width:100%;gap:16px;padding:16px}.orientation :global(img:first-child){width:72px;height:78px}.orientation :global(img:last-child){width:26px;height:78px}}
</style>
