---
import Icon from './Icon.astro';
---
<dialog id="plan-dialog" class="plan-dialog" aria-labelledby="plan-title">
 <div class="plan-top"><h2 id="plan-title">Residence floor plan</h2><button type="button" data-close aria-label="Close floor plan"><Icon name="close" size={22}/></button></div>
 <div class="plan-stage" data-plan-stage tabindex="0" role="region" aria-label="Floor plan. Use plus and minus to zoom, arrow keys to move when zoomed.">
  <img data-plan-image alt="" draggable="false" hidden/>
  <div class="plan-status" data-plan-status role="status" aria-live="polite"><p data-plan-message>Loading floor plan...</p><button type="button" data-plan-retry hidden>Try again</button></div>
 </div>
 <div class="plan-toolbar"><div class="zoom-tools"><button type="button" data-zoom-fit disabled>Fit</button><button type="button" data-zoom-out aria-label="Zoom out" disabled><Icon name="minus" size={20}/></button><output aria-live="polite" data-zoom-value>100%</output><button type="button" data-zoom-in aria-label="Zoom in" disabled><Icon name="plus" size={20}/></button></div><a data-plan-download aria-disabled="true" tabindex="-1" download>Download image</a></div>
 <p class="plan-hint">Drag to explore when zoomed. For detailed drawings, enquire about this residence.</p>
</dialog>
<style>
 .plan-dialog{margin:auto;width:min(1280px,calc(100vw - 48px));height:min(960px,calc(100dvh - 48px));max-width:none;max-height:none;border:0;background:var(--navy);color:white;padding:24px 32px;overflow:hidden}.plan-dialog::backdrop{background:#06111dd9;backdrop-filter:blur(6px)}.plan-top{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:48px}.plan-top h2{font:400 18px/1.5 var(--body)}.plan-top button{background:none;font-size:30px;width:44px;height:44px}.plan-stage{height:calc(100% - 148px);margin:16px auto 0;background:var(--paper);overflow:hidden;display:flex;align-items:center;justify-content:center;touch-action:none;outline-offset:-4px!important}.plan-stage.is-zoomed{cursor:grab;touch-action:none}.plan-stage.is-zoomed:active{cursor:grabbing}.plan-stage img{max-width:92%;max-height:92%;width:auto;height:auto;object-fit:contain;transform-origin:center;mix-blend-mode:darken;user-select:none;pointer-events:none}.plan-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:12px}.zoom-tools{display:flex;align-items:center;gap:12px}.zoom-tools button{min-width:44px;min-height:44px;background:transparent;border:1px solid #ffffff50;color:white;font-size:18px}.zoom-tools button:disabled{opacity:.3}.zoom-tools output{min-width:50px;text-align:center;font-size:14px}.plan-toolbar a{font-size:13px;text-decoration:underline;text-underline-offset:4px}.plan-hint{font-size:12px;line-height:1.5;color:#ffffff9c;margin-top:4px}@media(max-width:767px){.plan-dialog{width:100vw;height:100dvh;margin:0;padding:20px 24px}.plan-top h2{font-size:16px}.plan-stage{height:calc(100% - 176px)}.plan-toolbar{align-items:start;gap:10px;flex-wrap:wrap}.plan-toolbar a{min-height:32px;display:flex;align-items:center}.zoom-tools{gap:8px}.plan-hint{font-size:11px}}
</style>
<style>
 .plan-stage{position:relative}.plan-stage[aria-busy="true"]{cursor:progress}.plan-status{max-width:32rem;padding:24px;text-align:center;color:var(--navy);font-size:15px;line-height:1.6}.plan-status button{display:block;margin:16px auto 0;padding:10px 20px;border:1px solid currentColor;background:transparent;min-height:44px}.plan-toolbar a[aria-disabled="true"]{opacity:.4;text-decoration:none;cursor:default}
</style>
