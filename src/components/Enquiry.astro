---
import Action from './Action.astro';
---
<dialog id="enquiry-dialog" class="enquiry-dialog" aria-labelledby="enquiry-heading">
 <div class="enquiry-shell">
  <aside class="enquiry-editorial" aria-hidden="true"><span class="eyebrow">AVA at Palm Jumeirah</span><p class="display">A place<br/>beyond<br/>compare.</p><div class="enquiry-photo"></div></aside>
  <section class="enquiry-panel">
   <button type="button" class="close" data-close aria-label="Close enquiry">×</button>
   <div data-enquiry-content>
    <h2 class="display" id="enquiry-heading" tabindex="-1">Make an enquiry</h2>
    <p class="selected-context" data-enquiry-context>AVA at Palm Jumeirah</p>
    <form id="enquiry-form" novalidate>
     <input type="hidden" name="context" value="AVA at Palm Jumeirah" />
     <div class="field"><label for="enquiry-name">Full name <span class="sr-only">required</span></label><input id="enquiry-name" name="name" autocomplete="name" placeholder="Your name" required maxlength="100" aria-describedby="name-error" /><span class="field-error" id="name-error"></span></div>
     <div class="field"><label for="enquiry-email">Email address <span class="sr-only">required</span></label><input id="enquiry-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="Your email address" required maxlength="254" aria-describedby="email-error" /><span class="field-error" id="email-error"></span></div>
     <div class="field"><label for="enquiry-phone">Phone number <span>(optional)</span></label><input id="enquiry-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="Phone number" maxlength="30" aria-describedby="phone-error" /><span class="field-error" id="phone-error"></span></div>
     <div class="field field-message" hidden><label for="enquiry-message">Your message</label><textarea id="enquiry-message" name="message" rows="3" maxlength="2000"></textarea></div>
     <div class="hp" aria-hidden="true"><label for="enquiry-website">Website</label><input id="enquiry-website" name="website" tabindex="-1" autocomplete="off" /></div>
     <div class="consent"><input id="enquiry-consent" name="consent" type="checkbox" required aria-describedby="consent-error"/><label for="enquiry-consent">I agree to be contacted about my enquiry and have read the <a href="/privacy/" target="_blank" rel="noopener">privacy information</a>.</label></div><span class="field-error" id="consent-error"></span>
     <div class="form-error" role="alert" tabindex="-1" hidden></div>
     <button class="send-button" type="submit"><span class="send-circle" aria-hidden="true">+</span><span><span data-submit-label>Send enquiry</span><small>AVA at Palm Jumeirah</small></span></button>
     <p class="submission-note" role="status" aria-live="polite"></p>
    </form>
   </div>
   <div class="enquiry-success" hidden tabindex="-1"><p class="eyebrow">AVA at Palm Jumeirah</p><h2 class="display">Thank you.<br/>We have your enquiry.</h2><p>Your details have been received. Keep exploring while your enquiry is reviewed.</p><p class="enquiry-reference">Reference: <span data-enquiry-reference></span></p><Action label="Back to residences" href="/#residences" caption="Explore AVA at Palm Jumeirah" class="success-link" /></div>
  </section>
 </div>
</dialog>
<style>
 .enquiry-dialog{padding:0;border:0;width:min(1120px,calc(100vw - 80px));max-width:1120px;max-height:calc(100dvh - 60px);color:var(--ink);background:var(--cream);overflow:auto}.enquiry-dialog::backdrop{background:#071829c9;backdrop-filter:blur(7px)}.enquiry-shell{display:grid;grid-template-columns:.8fr 1fr;min-height:700px}.enquiry-editorial{position:relative;background:var(--ocean);color:var(--peach);padding:52px 40px;overflow:hidden}.enquiry-editorial>.display{font-size:70px;line-height:1.08;margin-top:60px;position:relative;z-index:1}.enquiry-photo{position:absolute;inset:310px 0 0;background:linear-gradient(var(--ocean),transparent 35%),url('/assets/aerial-2.webp') center/cover}.enquiry-panel{position:relative;padding:68px 48px 40px}.enquiry-panel h2{font-size:44px;line-height:1.12;color:var(--navy);outline:none}.close{position:absolute;right:20px;top:16px;width:44px;height:44px;font-size:32px;background:none;color:var(--navy);line-height:1}.selected-context{font-size:14px;line-height:1.6;margin:22px 0 32px;color:var(--navy)}form{display:flex;flex-direction:column;gap:22px}.field{display:flex;flex-direction:column;gap:8px}.field label{font-size:12px;line-height:1.5;color:var(--navy)}.field label span{color:#646268}.field input,.field textarea{width:100%;border:0;border-bottom:1px solid #8b8d96;background:transparent;color:var(--ink);padding:4px 0 14px;min-height:44px;font-size:16px;line-height:1.5;transition:border-color .2s;box-shadow:none}.field input::placeholder{color:#5b5c64;opacity:1}.field input:focus,.field textarea:focus{outline:none;border-color:var(--navy);border-bottom-width:2px;padding-bottom:13px}.field input[aria-invalid=true]{border-color:var(--error)}.field-error{font-size:12px;line-height:1.5;color:var(--error);min-height:0}.field-error:empty{display:none}.consent{display:flex;gap:12px;align-items:flex-start;padding-block:8px}.consent input{accent-color:var(--navy);flex:0 0 20px;width:20px;height:20px;margin:1px 0 0}.consent label{font-size:12px;line-height:1.7}.consent a{text-decoration:underline;text-underline-offset:3px}.form-error{color:var(--error);font-size:14px;line-height:1.5;border-left:2px solid currentColor;padding-left:14px}.send-button{display:flex;align-items:center;gap:18px;text-align:left;background:none;color:var(--navy);padding:0}.send-circle{width:51px;height:51px;border-radius:50%;display:grid;place-items:center;background:var(--navy);color:white;font-weight:300;font-size:28px;flex:none;transition:background .2s}.send-button:hover .send-circle{background:#34526d}.send-button small{display:block;margin-top:3px;font-size:12px;color:#916c59}.send-button:disabled{opacity:.55;cursor:wait}.submission-note{font-size:12px;line-height:1.5;color:var(--navy)}.submission-note:empty{display:none}.hp{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.enquiry-success{display:flex;flex-direction:column;gap:28px;padding-top:40px;outline:none}.enquiry-success h2{font-size:52px}.enquiry-success>p:not(.eyebrow){font-size:17px;line-height:1.65}.enquiry-success :global(.action){margin-top:24px}@media(max-width:767px){.enquiry-dialog{width:100vw;max-width:100vw;max-height:100dvh;height:100dvh;margin:0;background:var(--ocean)}.enquiry-shell{display:block;min-height:100%;padding:100px 24px 40px}.enquiry-editorial{display:none}.enquiry-panel{padding:32px 24px;background:var(--cream)}.enquiry-panel h2{font-size:34px}.close{top:-70px;right:0;color:var(--white);font-size:32px}.selected-context{margin:20px 0 24px}form{gap:20px}.enquiry-success{padding-top:0}.enquiry-success h2{font-size:42px}.consent label{font-size:12px}}
</style>
<style>.enquiry-success>p.enquiry-reference{font-size:12px;line-height:1.6;overflow-wrap:anywhere}</style>
