---
interface Props { label:string; caption?:string; href?:string; action?:string; context?:string; tone?:'light'|'dark'; class?:string; }
const {label,caption='AVA at Palm Jumeirah',href,action,context,tone='light',class:className=''}=Astro.props;
const Tag=href?'a':'button';
---
<Tag class:list={['action',`action--${tone}`,className]} href={href} type={href?undefined:'button'} data-action={action} data-context={context}>
  <span class="action__circle" aria-hidden="true"><span></span></span>
  <span class="action__copy"><span class="action__label">{label}</span>{caption&&<span class="action__caption">{caption}</span>}</span>
</Tag>
<style>
 .action{display:inline-flex;gap:20px;align-items:center;text-align:left;background:none;padding:0;color:var(--ink);min-height:51px;max-width:100%;font-size:16px;line-height:1.4}.action__circle{position:relative;display:block;width:51px;height:51px;flex:0 0 51px;border:1px solid transparent;border-radius:50%;background:var(--navy);color:var(--white);transition:background .2s,color .2s,transform .3s}.action__circle::before,.action__circle::after{content:'';position:absolute;background:currentColor;top:50%;left:50%;width:15px;height:1px;transform:translate(-50%,-50%)}.action__circle::after{transform:translate(-50%,-50%) rotate(90deg)}.action__copy{display:flex;flex-direction:column;gap:2px}.action__caption{font-size:12px;color:#9c7664;line-height:1.5}.action--dark{color:var(--white)}.action--dark .action__circle{background:var(--cream);color:var(--navy)}.action--dark .action__caption{color:var(--peach)}.action:hover .action__circle{background:var(--peach);color:var(--navy);transform:rotate(90deg)}.action:focus-visible{outline-color:var(--peach)}.action:disabled{opacity:.4;pointer-events:none}@media(max-width:767px){.action{gap:16px;font-size:15px}.action__caption{font-size:11px}}
</style>
