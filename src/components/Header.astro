---
interface Props {home?:boolean;}
const {home=false}=Astro.props;
const prefix=home?'':'/';
const links=[['Home',prefix+'#home'],['About',prefix+'#about'],['Residences',prefix+'#residences'],['Features',prefix+'#features'],['Interior',prefix+'#interiors']];
---
<header class="header site-width" data-node-id="1:1765">
 <nav class="desktop-nav" aria-label="Main navigation">{links.map(([name,href])=><a href={href}>{name}</a>)}</nav>
 <a class="brand" href="/" aria-label="AVA at Palm Jumeirah home"><span aria-hidden="true"></span></a>
 <button class="header-enquiry" type="button" data-action="enquire" data-context="AVA at Palm Jumeirah">A touch of perfection <img src="/assets/nav-2.svg" alt="" /></button>
 <button class="menu-toggle" type="button" data-action="menu" aria-haspopup="dialog" aria-controls="menu-dialog" aria-expanded="false">Menu</button>
</header>
<style>
 .header{position:absolute;inset:0 0 auto;height:120px;z-index:15;display:flex;align-items:flex-start;justify-content:space-between;padding:54px var(--gutter) 0;color:var(--white)}.desktop-nav{display:flex;gap:16px;font-family:Inter,sans-serif;font-size:12px;line-height:15px;letter-spacing:-.02em;text-transform:uppercase}.desktop-nav a{position:relative;min-height:32px}.desktop-nav a::after{content:'';position:absolute;left:0;right:0;bottom:10px;height:1px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .25s}.desktop-nav a:hover::after{transform:scaleX(1)}.brand{position:absolute;width:78.75px;height:63px;top:30px;left:50%;transform:translateX(-50%)}.brand span{display:block;width:100%;height:100%;background:currentColor;mask:url('/assets/nav-1.webp') center/contain no-repeat}.header-enquiry{padding:0;display:flex;align-items:center;gap:10px;font-family:Inter,sans-serif;font-size:12px;line-height:15px;letter-spacing:-.02em;text-transform:uppercase;background:transparent;min-height:28px}.header-enquiry img{flex:none}.menu-toggle{display:none;background:none;min-width:56px;min-height:44px;padding:0;font-size:14px}@media(max-width:1050px){.desktop-nav{gap:12px;font-size:10px}.header-enquiry{font-size:10px}}@media(max-width:767px){.header{height:100px;padding:24px;align-items:flex-start}.desktop-nav,.header-enquiry{display:none}.brand{left:24px;top:24px;width:58px;height:46.4px;transform:none}.menu-toggle{display:block;margin-left:auto}}
</style>
