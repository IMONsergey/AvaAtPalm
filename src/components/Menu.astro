---
import Icon from './Icon.astro';
const links=[['Home','/#home'],['About','/#about'],['The Sky Palace','/#sky-palace'],['Residences','/#residences'],['Interiors','/#interiors'],['Features','/#features'],['Location','/#location']];
---
<dialog class="menu-dialog" id="menu-dialog" aria-labelledby="menu-title">
 <div class="menu-top"><a class="menu-brand" href="/" aria-label="AVA home"></a><button type="button" class="close-text" data-close>Close <Icon name="close" size={22}/></button></div>
 <h2 class="sr-only" id="menu-title">Explore AVA at Palm Jumeirah</h2>
 <div class="menu-scroll" data-dialog-scroll>
 <nav aria-label="Mobile navigation">{links.map(([label,href])=><a class="display" href={href} data-menu-link>{label}</a>)}</nav>
 <p class="menu-note">AVA at Palm Jumeirah<br/>Dorchester Collection, Dubai</p>
 </div>
</dialog>
<style>
 .menu-dialog{border:0;padding:24px;color:var(--white);background:var(--ocean);width:min(100%,500px);max-width:100%;height:100dvh;max-height:100dvh;margin:0 0 0 auto;overflow:hidden}.menu-dialog[open]{display:flex;flex-direction:column}.menu-scroll{min-height:0;overflow:auto;overscroll-behavior:contain}.menu-dialog::backdrop{background:#071829aa;backdrop-filter:blur(5px)}.menu-top{flex:none;display:flex;justify-content:space-between;align-items:start}.menu-brand{width:58px;height:46.4px;background:white;mask:url('/assets/nav-1.webp') center/contain no-repeat}.close-text{min-height:44px;background:none;padding:0;font-size:14px;display:flex;align-items:center;gap:12px}.close-text span{font-size:24px}.menu-dialog nav{display:flex;flex-direction:column;gap:20px;padding:76px 0 50px}.menu-dialog nav a{font-size:36px;line-height:1.3;transition:color .2s}.menu-dialog nav a:hover{color:var(--peach)}.menu-note{font-size:12px;line-height:1.7;color:var(--peach)}
</style>
